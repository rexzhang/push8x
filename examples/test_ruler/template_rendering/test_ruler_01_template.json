{
  "description": "模板渲染测试",
  "input_msg": {
    "from_name": "John Doe",
    "title": "Hello World",
    "content": "This is a test."
  },
  "output_result": [
    [
      {
        "from_name": "John Doe",
        "from_value": "sender@example.com",
        "to_name": "Recipient",
        "to_value": "recipient@example.com",
        "title": "RE: Hello World",
        "content": "From: John Doe\nOriginal: This is a test.",
        "content_format": "plain",
        "attachments": [],
        "ext": {},
        "receiver": "smtpd",
        "receiver_ext": {
          "mark": ""
        },
        "ruler_matched_rules": [
          {
            "sender_name": "smtp",
            "enable": true,
            "name": "R001",
            "ignore_if_matched_other_rule": false,
            "skip_receiver": null,
            "skip_receiver_mark": null,
            "skip_from_name": null,
            "skip_from_value": null,
            "skip_to_name": null,
            "skip_to_value": null,
            "skip_title": null,
            "match_receiver": null,
            "match_receiver_mark": null,
            "match_from_name": null,
            "match_from_value": null,
            "match_to_name": null,
            "match_to_value": null,
            "match_title": null,
            "ignore_other_rule_if_matched": false,
            "new_from_name": null,
            "new_from_value": null,
            "new_to_name": null,
            "new_to_value": null,
            "new_title": "RE: {{ msg.title }}",
            "new_content": "From: {{ msg.from_name }}\nOriginal: {{ msg.content }}"
          }
        ]
      },
      null
    ]
  ]
}